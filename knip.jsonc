// Dead code and unused dependencies (docs/architecture.md). Run: pnpm knip
{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  // Code copies of meritum-design-system (scripts/sync.sh), checked by SHA256SUMS; knip does
  // not analyse the other copies (copy/pl.json, tokens/meritum.css).
  "ignore": ["contracts/**", "platforms/**"],
  // dependency-cruiser's TypeScript parser (parser: "swc" in .dependency-cruiser.cjs).
  "ignoreDependencies": ["@swc/core"]
}
