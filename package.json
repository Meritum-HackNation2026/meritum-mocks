{
  "name": "meritum-mocks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "check": "biome check .",
    "typecheck": "tsc",
    "test": "node --import tsx --import ./tests/setup-dom.ts --test \"src/**/*.test.ts\" \"tests/**/*.test.{ts,tsx}\"",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "sync": "scripts/sync.sh",
    "sync:check": "scripts/check-sync.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@happy-dom/global-registrator": "^21.0.4",
    "@swc/core": "^1.16.22",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.8.0",
    "knip": "^6.47.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
